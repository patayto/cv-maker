# Database (required for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Authentication (required for production)
AUTH_USERNAME=your_username
AUTH_PASSWORD_HASH=your_bcrypt_hash

# Disable authentication for local development (DO NOT use in production)
DISABLE_AUTH=true

# CORS origins (comma-separated)
CORS_ORIGINS=https://your-app.netlify.app

# AI features (optional) - OpenRouter, https://openrouter.ai/keys
# OPENROUTER_MODELS is a comma-separated list; requests rotate round-robin with backoff
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free

# Debug (disable in production)
DEBUG_SCRAPING=false