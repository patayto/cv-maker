# Copy this file to .env and fill in real values before running docker compose.

# PostgreSQL credentials (used by both db and backend services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication
# Set DISABLE_AUTH=true for local/personal use (default).
# For a shared/public deployment, set DISABLE_AUTH=false and provide credentials.
DISABLE_AUTH=true
AUTH_USERNAME=admin
# Generate a bcrypt hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
AUTH_PASSWORD_HASH=

# CORS allowed origins (comma-separated). Adjust if exposing on a domain.
CORS_ORIGINS=http://localhost

# AI API keys (optional — features degrade gracefully without them)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LinkedIn scraping cookie (optional)
LINKEDIN_LI_AT=

# Debug Mode (optional - for troubleshooting scraping issues)
# When enabled:
#   - Logs request/response details to console (status, redirects, headers, cookies)
#   - Saves raw HTML to backend/debug/last_response.html
#   - Adds diagnostic info to error messages
DEBUG_SCRAPING=true
